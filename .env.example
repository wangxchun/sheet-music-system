# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and is never committed.

# Claude API key, used by tools/extract_toc.py
# Create one at https://platform.claude.com/ (Settings → API keys)
ANTHROPIC_API_KEY=

# Optional: Google credential files, if not stored in secrets/
# GOOGLE_OAUTH_CLIENT_FILE=secrets/google_oauth_client.json
# GOOGLE_TOKEN_FILE=secrets/google_token.json

# LangSmith tracing, used by agent/ (create a key at https://smith.langchain.com/ → Settings → API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=piano-catalog-agent
# Only if your LangSmith account is in the EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
